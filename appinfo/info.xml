<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>hyperviewer</id>
    <name>Hyper Viewer</name>
    <summary>Review footage instantly, choose highlights, and export only what you need in full quality.</summary>
    <description><![CDATA[HLS proxies, Shaka playback, frame-accurate clipping, and original-quality export — with a queue-backed encoder for Nextcloud 35.]]></description>
    <version>2.1.8</version>
    <licence>agpl</licence>
    <author mail="irgipaulius@gmail.com" homepage="https://github.com/irgipaulius">Paulius Jacinkevičius</author>
    <namespace>HyperViewer</namespace>
    <category>files</category>
    <category>multimedia</category>
    <bugs>https://github.com/irgipaulius/hyperviewer/issues</bugs>
    <dependencies>
        <nextcloud min-version="30" max-version="35"/>
        <php min-version="8.1" max-version="8.4"/>
    </dependencies>
    <background-jobs>
        <job>OCA\HyperViewer\BackgroundJob\ProcessHvQueueJob</job>
        <job>OCA\HyperViewer\BackgroundJob\ScheduledScanJob</job>
        <job>OCA\HyperViewer\BackgroundJob\CacheGcJob</job>
        <job>OCA\HyperViewer\BackgroundJob\StaleJobRecoveryJob</job>
    </background-jobs>
    <commands>
        <command>OCA\HyperViewer\Command\WorkerCommand</command>
        <command>OCA\HyperViewer\Command\ScanCommand</command>
        <command>OCA\HyperViewer\Command\ReindexCommand</command>
        <command>OCA\HyperViewer\Command\CacheStatsCommand</command>
        <command>OCA\HyperViewer\Command\MetadataBackfillCommand</command>
    </commands>
    <types>
        <type>video/quicktime</type>
        <type>video/mp4</type>
    </types>
    <activity>
        <provider>OCA\HyperViewer\Activity\Provider</provider>
    </activity>
    <settings>
        <admin>OCA\HyperViewer\Settings\AdminSettings</admin>
        <admin-section>OCA\HyperViewer\Settings\AdminSection</admin-section>
        <personal>OCA\HyperViewer\Settings\PersonalSettings</personal>
        <personal-section>OCA\HyperViewer\Settings\PersonalSection</personal-section>
    </settings>
</info>
